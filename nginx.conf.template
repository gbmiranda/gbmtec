# Site estático da GBM Tecnologia. Escuta em ${PORT}.
server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    gzip on;
    gzip_vary on;
    gzip_min_length 512;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain application/xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Verificação de saúde para a UpUai
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # HTML sempre revalidado; imagens e logos com cache longo; CSS e JS com cache curto.
    # Só `expires` aqui: add_header dentro de location apagaria os cabeçalhos de segurança acima.
    location / {
        try_files $uri $uri/ =404;
        expires -1;
    }
    location /assets/img/ { expires 30d; }
    location /assets/logo/ { expires 30d; }
    location ~* \.(css|js)$ { expires 1h; }

    error_page 404 /404.html;
    location = /404.html { internal; }
}
