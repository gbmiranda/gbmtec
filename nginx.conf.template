# Site estático da GBM Tecnologia, pensado para rodar sem root (UID 1000) na UpUai.
# A porta vem de ${PORT}; pid e temporários ficam em /app/tmp.
worker_processes auto;
pid /app/tmp/nginx.pid;
error_log stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    charset utf-8;
    server_tokens off;
    sendfile on;
    access_log off;

    client_body_temp_path /app/tmp/client_body;
    proxy_temp_path       /app/tmp/proxy;
    fastcgi_temp_path     /app/tmp/fastcgi;
    uwsgi_temp_path       /app/tmp/uwsgi;
    scgi_temp_path        /app/tmp/scgi;

    gzip on;
    gzip_vary on;
    gzip_min_length 512;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain application/xml;

    server {
        listen ${PORT};
        listen [::]:${PORT};
        server_name _;

        root /usr/share/nginx/html;
        index index.html;

        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

        # Verificação de saúde para a UpUai
        location = /healthz {
            default_type text/plain;
            return 200 "ok\n";
        }

        # HTML sempre revalidado; imagens e logos com cache longo; CSS e JS com cache curto.
        # Só `expires` aqui: add_header dentro de location apagaria os cabeçalhos de segurança acima.
        location / {
            try_files $uri $uri/ =404;
            expires -1;
        }
        location /assets/img/ { expires 30d; }
        location /assets/logo/ { expires 30d; }
        location ~* \.(css|js)$ { expires 1h; }

        error_page 404 /404.html;
        location = /404.html { internal; }
    }
}
